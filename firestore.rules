rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection check endpoint for startup validation
    match /test/connection {
      allow get: if true;
    }

    // ---- Global Primitives ----
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAuth() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedAuth() && (
        request.auth.token.email == 'saidahnat6@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAllowedIncrementDelta(delta) {
      return delta in [1, 10, 33, 100];
    }

    function isAllowedAnyDelta(delta) {
      return delta in [1, 10, 33, 100, -1, -10, -33, -100];
    }

    // ---- Entity Validation Blueprints ----
    function isValidParticipant(data) {
      return data.keys().hasAll([
        'id', 'displayName', 'city', 'totalIstighfar',
        'lastLogId', 'lastLogDelta', 'isPublic', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'id', 'displayName', 'city', 'totalIstighfar',
        'lastLogId', 'lastLogDelta', 'isPublic', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 50
      && data.city is string && data.city.size() >= 0 && data.city.size() <= 50
      && data.totalIstighfar is int && data.totalIstighfar >= 0 && data.totalIstighfar <= 1000000000
      && isValidId(data.lastLogId)
      && data.lastLogDelta is int && data.lastLogDelta in [0, 1, 10, 33, 100]
      && data.isPublic is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidParticipantSecret(data) {
      return data.keys().hasAll([
        'participantId', 'secretToken', 'lastLogId', 'lastDelta', 'lastActionAt', 'createdAt'
      ]) && data.keys().hasOnly([
        'participantId', 'secretToken', 'lastLogId', 'lastDelta', 'lastActionAt', 'createdAt'
      ])
      && isValidId(data.participantId)
      && data.secretToken is string && data.secretToken.size() >= 24 && data.secretToken.size() <= 128 && data.secretToken.matches('^[a-zA-Z0-9_\\-]+$')
      && isValidId(data.lastLogId)
      && data.lastDelta is int && data.lastDelta in [0, 1, 10, 33, 100, -1, -10, -33, -100]
      && data.lastActionAt is timestamp
      && data.createdAt is timestamp;
    }

    function isValidCampaignStats(data) {
      return data.keys().hasAll([
        'totalIstighfar', 'totalParticipants', 'todayIstighfar', 'todayDate',
        'weeklyIstighfar', 'weekKey', 'monthlyIstighfar', 'monthKey', 'lastLogId', 'lastUpdated'
      ]) && data.keys().hasOnly([
        'totalIstighfar', 'totalParticipants', 'todayIstighfar', 'todayDate',
        'weeklyIstighfar', 'weekKey', 'monthlyIstighfar', 'monthKey', 'lastLogId', 'lastUpdated'
      ])
      && data.totalIstighfar is int && data.totalIstighfar >= 0
      && data.totalParticipants is int && data.totalParticipants >= 0
      && data.todayIstighfar is int && data.todayIstighfar >= 0
      && data.todayDate is string && data.todayDate.size() == 10 && data.todayDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && data.weeklyIstighfar is int && data.weeklyIstighfar >= 0
      && data.weekKey is string && data.weekKey.size() == 8 && data.weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
      && data.monthlyIstighfar is int && data.monthlyIstighfar >= 0
      && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
      && isValidId(data.lastLogId)
      && data.lastUpdated is timestamp;
    }

    function isValidIstighfarLog(data) {
      return data.keys().hasAll([
        'id', 'participantId', 'proofToken', 'count', 'actionType',
        'date', 'weekKey', 'monthKey', 'createdAt'
      ]) && data.keys().hasOnly([
        'id', 'participantId', 'proofToken', 'count', 'actionType',
        'date', 'weekKey', 'monthKey', 'createdAt'
      ])
      && isValidId(data.id)
      && isValidId(data.participantId)
      && data.proofToken is string && data.proofToken.size() >= 24 && data.proofToken.size() <= 128 && data.proofToken.matches('^[a-zA-Z0-9_\\-]+$')
      && data.count is int && isAllowedAnyDelta(data.count)
      && data.actionType is string && data.actionType in ['increment', 'undo']
      && ((data.actionType == 'increment' && data.count > 0) || (data.actionType == 'undo' && data.count < 0))
      && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && data.weekKey is string && data.weekKey.size() == 8 && data.weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
      && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
      && data.createdAt is timestamp;
    }

    function isValidCampaignSettings(data) {
      return data.keys().hasAll([
        'dailyMessage', 'campaignGoal', 'isRegistrationOpen', 'announcement', 'updatedAt', 'updatedBy'
      ]) && data.keys().hasOnly([
        'dailyMessage', 'campaignGoal', 'isRegistrationOpen', 'announcement', 'updatedAt', 'updatedBy'
      ])
      && data.dailyMessage is string && data.dailyMessage.size() >= 3 && data.dailyMessage.size() <= 500
      && data.campaignGoal is int && data.campaignGoal >= 1000 && data.campaignGoal <= 1000000000
      && data.isRegistrationOpen is bool
      && data.announcement is string && data.announcement.size() <= 300
      && data.updatedAt is timestamp
      && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128;
    }

    function isValidSuspiciousEvent(data) {
      return data.keys().hasAll(['id', 'participantId', 'reason', 'attemptedDelta', 'createdAt'])
      && data.keys().hasOnly(['id', 'participantId', 'reason', 'attemptedDelta', 'createdAt'])
      && isValidId(data.id)
      && data.participantId is string && data.participantId.size() >= 1 && data.participantId.size() <= 64
      && data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 200
      && data.attemptedDelta is int && data.attemptedDelta >= -1000000 && data.attemptedDelta <= 1000000
      && data.createdAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'addedAt'])
      && data.keys().hasOnly(['uid', 'email', 'addedAt'])
      && isValidId(data.uid)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
      && data.addedAt is timestamp;
    }

    // ---- Collection Rules ----

    match /participants/{participantId} {
      allow get: if isValidId(participantId);
      allow list: if existing().isPublic == true || isAdmin();

      allow create: if isValidId(participantId)
        && isValidParticipant(incoming())
        && incoming().id == participantId
        && incoming().totalIstighfar == 0
        && incoming().lastLogId == 'none'
        && incoming().lastLogDelta == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/participantSecrets/$(participantId))
        && exists(/databases/$(database)/documents/campaignStats/global)
        && getAfter(/databases/$(database)/documents/campaignStats/global).data.totalParticipants
           == get(/databases/$(database)/documents/campaignStats/global).data.totalParticipants + 1;

      allow update: if isValidId(participantId)
        && isValidParticipant(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['totalIstighfar', 'lastLogId', 'lastLogDelta', 'updatedAt'])
            && getAfter(/databases/$(database)/documents/participantSecrets/$(participantId)).data.lastActionAt == request.time
            && getAfter(/databases/$(database)/documents/participantSecrets/$(participantId)).data.lastDelta == (incoming().totalIstighfar - existing().totalIstighfar)
            && (
              (
                isAllowedIncrementDelta(incoming().totalIstighfar - existing().totalIstighfar)
                && incoming().lastLogDelta == (incoming().totalIstighfar - existing().totalIstighfar)
                && incoming().lastLogId != existing().lastLogId
                && existsAfter(/databases/$(database)/documents/istighfarLogs/$(incoming().lastLogId))
                && getAfter(/databases/$(database)/documents/istighfarLogs/$(incoming().lastLogId)).data.participantId == participantId
                && getAfter(/databases/$(database)/documents/istighfarLogs/$(incoming().lastLogId)).data.count == (incoming().totalIstighfar - existing().totalIstighfar)
              ) ||
              (
                existing().lastLogDelta > 0
                && existing().lastLogId != 'none'
                && existing().lastLogId != 'undone'
                && (incoming().totalIstighfar - existing().totalIstighfar) == -existing().lastLogDelta
                && incoming().lastLogDelta == 0
                && incoming().lastLogId == 'undone'
              )
            )
          )
        );

      allow delete: if isValidId(participantId) && isAdmin();
    }

    match /participantSecrets/{participantId} {
      // Strictly non-readable by any client to isolate secret ownership tokens
      allow read: if false;

      allow create: if isValidId(participantId)
        && isValidParticipantSecret(incoming())
        && incoming().participantId == participantId
        && incoming().lastLogId == 'none'
        && incoming().lastDelta == 0
        && incoming().createdAt == request.time
        && incoming().lastActionAt == request.time
        && existsAfter(/databases/$(database)/documents/participants/$(participantId));

      allow update: if isValidId(participantId)
        && isValidParticipantSecret(incoming())
        && incoming().participantId == existing().participantId
        && incoming().secretToken == existing().secretToken
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastLogId', 'lastDelta', 'lastActionAt'])
        && incoming().lastLogId != existing().lastLogId
        && incoming().lastActionAt == request.time
        && request.time >= existing().lastActionAt + duration.value(250, 'ms')
        && existsAfter(/databases/$(database)/documents/istighfarLogs/$(incoming().lastLogId))
        && getAfter(/databases/$(database)/documents/istighfarLogs/$(incoming().lastLogId)).data.participantId == participantId
        && getAfter(/databases/$(database)/documents/istighfarLogs/$(incoming().lastLogId)).data.proofToken == existing().secretToken
        && getAfter(/databases/$(database)/documents/istighfarLogs/$(incoming().lastLogId)).data.count == incoming().lastDelta;

      allow delete: if isValidId(participantId) && isAdmin();
    }

    match /campaignStats/{statId} {
      allow get: if isValidId(statId) && statId == 'global';
      allow list: if isAdmin();

      // Allow safe zero-initialized creation if not yet bootstrapped
      allow create: if isValidId(statId)
        && statId == 'global'
        && isValidCampaignStats(incoming())
        && incoming().totalIstighfar == 0
        && incoming().totalParticipants == 0
        && incoming().todayIstighfar == 0
        && incoming().weeklyIstighfar == 0
        && incoming().monthlyIstighfar == 0
        && incoming().lastLogId == 'init'
        && incoming().lastUpdated == request.time;

      allow update: if isValidId(statId)
        && statId == 'global'
        && isValidCampaignStats(incoming())
        && incoming().lastUpdated == request.time
        && (
          isAdmin() ||
          (
            // Action 1: New participant joined atomically
            incoming().diff(existing()).affectedKeys().hasOnly(['totalParticipants', 'lastLogId', 'lastUpdated'])
            && incoming().totalParticipants == existing().totalParticipants + 1
            && !exists(/databases/$(database)/documents/participants/$(incoming().lastLogId))
            && existsAfter(/databases/$(database)/documents/participants/$(incoming().lastLogId))
          ) ||
          (
            // Action 2: Istighfar increment or undo linked atomically to istighfarLogs
            incoming().diff(existing()).affectedKeys().hasOnly([
              'totalIstighfar', 'todayIstighfar', 'todayDate',
              'weeklyIstighfar', 'weekKey', 'monthlyIstighfar', 'monthKey',
              'lastLogId', 'lastUpdated'
            ])
            && incoming().totalParticipants == existing().totalParticipants
            && incoming().lastLogId != existing().lastLogId
            && isAllowedAnyDelta(incoming().totalIstighfar - existing().totalIstighfar)
            && existsAfter(/databases/$(database)/documents/istighfarLogs/$(incoming().lastLogId))
            && getAfter(/databases/$(database)/documents/istighfarLogs/$(incoming().lastLogId)).data.count == (incoming().totalIstighfar - existing().totalIstighfar)
            && (
              (
                incoming().todayDate == existing().todayDate
                && (
                  (existing().todayIstighfar + (incoming().totalIstighfar - existing().totalIstighfar) >= 0 && incoming().todayIstighfar == existing().todayIstighfar + (incoming().totalIstighfar - existing().totalIstighfar))
                  || (existing().todayIstighfar + (incoming().totalIstighfar - existing().totalIstighfar) < 0 && incoming().todayIstighfar == 0)
                )
              ) ||
              (
                incoming().todayDate > existing().todayDate
                && (
                  ((incoming().totalIstighfar - existing().totalIstighfar) > 0 && incoming().todayIstighfar == (incoming().totalIstighfar - existing().totalIstighfar))
                  || ((incoming().totalIstighfar - existing().totalIstighfar) < 0 && incoming().todayIstighfar == 0)
                )
              )
            )
            && (
              (
                incoming().weekKey == existing().weekKey
                && (
                  (existing().weeklyIstighfar + (incoming().totalIstighfar - existing().totalIstighfar) >= 0 && incoming().weeklyIstighfar == existing().weeklyIstighfar + (incoming().totalIstighfar - existing().totalIstighfar))
                  || (existing().weeklyIstighfar + (incoming().totalIstighfar - existing().totalIstighfar) < 0 && incoming().weeklyIstighfar == 0)
                )
              ) ||
              (
                incoming().weekKey > existing().weekKey
                && (
                  ((incoming().totalIstighfar - existing().totalIstighfar) > 0 && incoming().weeklyIstighfar == (incoming().totalIstighfar - existing().totalIstighfar))
                  || ((incoming().totalIstighfar - existing().totalIstighfar) < 0 && incoming().weeklyIstighfar == 0)
                )
              )
            )
            && (
              (
                incoming().monthKey == existing().monthKey
                && (
                  (existing().monthlyIstighfar + (incoming().totalIstighfar - existing().totalIstighfar) >= 0 && incoming().monthlyIstighfar == existing().monthlyIstighfar + (incoming().totalIstighfar - existing().totalIstighfar))
                  || (existing().monthlyIstighfar + (incoming().totalIstighfar - existing().totalIstighfar) < 0 && incoming().monthlyIstighfar == 0)
                )
              ) ||
              (
                incoming().monthKey > existing().monthKey
                && (
                  ((incoming().totalIstighfar - existing().totalIstighfar) > 0 && incoming().monthlyIstighfar == (incoming().totalIstighfar - existing().totalIstighfar))
                  || ((incoming().totalIstighfar - existing().totalIstighfar) < 0 && incoming().monthlyIstighfar == 0)
                )
              )
            )
          )
        );

      allow delete: if isAdmin();
    }

    match /istighfarLogs/{logId} {
      allow read: if isAdmin();

      allow create: if isValidId(logId)
        && isValidIstighfarLog(incoming())
        && incoming().id == logId
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/participantSecrets/$(incoming().participantId))
        && incoming().proofToken == get(/databases/$(database)/documents/participantSecrets/$(incoming().participantId)).data.secretToken
        && getAfter(/databases/$(database)/documents/participantSecrets/$(incoming().participantId)).data.lastActionAt == request.time
        && getAfter(/databases/$(database)/documents/participantSecrets/$(incoming().participantId)).data.lastLogId == logId
        && getAfter(/databases/$(database)/documents/campaignStats/global).data.lastLogId == logId;

      allow update: if false;
      allow delete: if isAdmin();
    }

    match /campaignSettings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'public';
      allow list: if isAdmin();

      allow create, update: if isValidId(settingId)
        && settingId == 'public'
        && isAdmin()
        && isValidCampaignSettings(incoming())
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    match /suspiciousEvents/{eventId} {
      allow read: if isAdmin();

      allow create: if isValidId(eventId)
        && isValidSuspiciousEvent(incoming())
        && incoming().id == eventId
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && (isAdmin() || (isVerifiedAuth() && request.auth.uid == uid));
      allow list: if isAdmin();
      allow create, update: if isValidId(uid) && isAdmin() && isValidAdminUser(incoming());
      allow delete: if isValidId(uid) && isAdmin();
    }
  }
}
